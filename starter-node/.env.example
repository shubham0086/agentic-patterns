# ─────────────────────────────────────────────────────────────────────────────
# Agentic Patterns Starter — Environment Variables
# Copy this file to .env and fill in the values you have.
# The starter works with OLLAMA only — no API keys required to run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider Priority ─────────────────────────────────────────────────────────
# Comma-separated list of providers in fallback order.
# Only providers with keys set (or Ollama which needs no key) will be used.
PROVIDER_ORDER=ollama,opencode,openrouter,gemini

# ── Ollama (local — no key needed, always the safe fallback) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Other good options: llama3.1:8b, mistral:7b, phi3:mini

# ── OpenCode Zen (free tier — sign up at opencode.ai) ────────────────────────
# OPENCODE_API_KEY=your_key_here
OPENCODE_MODEL=minimax-m2.5-free

# ── OpenRouter (pay-per-token, many models) ───────────────────────────────────
# OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic ─────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Budget Guard ──────────────────────────────────────────────────────────────
# Hard limit per run in USD. Pipeline stops if exceeded.
BUDGET_USD=0.50

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
